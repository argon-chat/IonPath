{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IonPath",
  "scopeName": "source.ion",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#keywords" },
    { "include": "#modifiers" },
    { "include": "#attributes" },
    { "include": "#withClause" },
    { "include": "#genericBuiltinTypes" },
    { "include": "#builtinTypes" },
    { "include": "#strings" },
    { "include": "#quotedStrings" },
    { "include": "#numbers" },
    { "include": "#entityNames" },
    { "include": "#typeParameters" },
    { "include": "#fieldNames" },
    { "include": "#inheritanceType" },
    { "include": "#functionNames" },
    { "include": "#enumMembers" },
    { "include": "#unionCases" },
    { "include": "#typeReference" }
  ],
  "repository": {
    "comments": {
      "comment": "Order matters: the most specific marker must be listed first so that /** wins over /*, and //! and /// win over //.",
      "patterns": [
        { "include": "#docBlockComment" },
        { "include": "#blockComment" },
        { "include": "#moduleDocComment" },
        { "include": "#docLineComment" },
        { "include": "#lineComment" }
      ]
    },
    "docBlockComment": {
      "comment": "/** ... */ doc block comment. The (?!/) guard keeps the empty /**/ out of this rule so it falls through to #blockComment.",
      "name": "comment.block.documentation.ion",
      "begin": "/\\*\\*(?!/)",
      "end": "\\*/",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.begin.ion" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.end.ion" }
      },
      "patterns": [
        {
          "comment": "Leading * on continuation lines is stripped by the compiler; scope it as punctuation.",
          "name": "punctuation.definition.comment.ion",
          "match": "^\\s*\\*(?!/)"
        }
      ]
    },
    "blockComment": {
      "comment": "/* ... */ ordinary block comment. Non-nesting: the first */ closes it.",
      "name": "comment.block.ion",
      "begin": "/\\*",
      "end": "\\*/",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.comment.begin.ion" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.comment.end.ion" }
      }
    },
    "moduleDocComment": {
      "comment": "//! module-level doc comment.",
      "name": "comment.line.documentation.ion",
      "match": "(//!).*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.documentation.ion" }
      }
    },
    "docLineComment": {
      "comment": "/// doc comment attached to the following declaration. The (?!/) guard keeps //// an ordinary line comment, matching the compiler.",
      "name": "comment.line.documentation.ion",
      "match": "(///)(?!/).*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.documentation.ion" }
      }
    },
    "lineComment": {
      "comment": "// ordinary line comment (pure trivia).",
      "name": "comment.line.double-slash.ion",
      "match": "(//).*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.ion" }
      }
    },
    "directives": {
      "patterns": [
        {
          "name": "meta.directive.import.ionpath",
          "match": "(#import)\\s*(\\{)([^}]*)(\\})\\s*(from)\\s*(\"[^\"]*\")(;?)",
          "captures": {
            "1": { "name": "keyword.control.directive.ionpath" },
            "2": { "name": "punctuation.definition.block.begin.ionpath" },
            "3": {
              "patterns": [
                {
                  "name": "entity.name.type.import.ionpath",
                  "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
                },
                {
                  "name": "punctuation.separator.comma.ionpath",
                  "match": ","
                }
              ]
            },
            "4": { "name": "punctuation.definition.block.end.ionpath" },
            "5": { "name": "keyword.control.from.ionpath" },
            "6": { "name": "string.quoted.double.ionpath" },
            "7": { "name": "punctuation.terminator.ionpath" }
          }
        },
        {
          "name": "meta.directive.ionpath",
          "match": "(#(?:use|feature))\\s+(\"[^\"]*\")",
          "captures": {
            "1": { "name": "keyword.control.directive.ionpath" },
            "2": { "name": "string.quoted.double.ionpath" }
          }
        },
        {
          "name": "keyword.control.directive.ionpath",
          "match": "#(?:use|feature|import)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "`with` is here rather than in #modifiers because it introduces a clause, like `from` in an #import, not a property of the declaration. `mixin` is a declaration keyword like `msg`, even though a mixin is not a type.",
          "name": "keyword.control.ionpath",
          "match": "\\b(msg|mixin|with|flags|enum|typedef|service|union|attribute)\\b"
        }
      ]
    },
    "withClause": {
      "comment": "The names in `with Audited, Traced`. Scoped as entity.name.type so they read as references to a declaration; without this rule they fall through to #fieldNames or to nothing, because a clause entry is not followed by a ':' or a '('.",
      "patterns": [
        {
          "begin": "\\b(with)\\s+",
          "end": "(?=\\{)|$",
          "beginCaptures": {
            "1": { "name": "keyword.control.ionpath" }
          },
          "patterns": [
            {
              "name": "entity.name.type.mixin.ionpath",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.ionpath",
              "match": ","
            },
            { "include": "#comments" }
          ]
        }
      ]
    },
    "modifiers": {
      "patterns": [
        {
          "name": "storage.modifier.ionpath",
          "match": "\\b(stream|unary|internal)\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.ionpath",
          "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.annotation.ionpath" },
            "2": { "name": "support.function.decorator.ionpath" }
          }
        }
      ]
    },
    "builtinTypes": {
      "comment": "Kept in step with IonModule.GetStdModule. The retired `vector` feature's vec2f..vec4h lived here after the types were deleted; anything listed that the compiler does not declare is a name the editor recommends and the build then rejects.",
      "patterns": [
        {
          "name": "storage.type.primitive.ionpath",
          "match": "\\b(i1|i2|i4|i8|i16|u1|u2|u4|u8|u16|f2|f4|f8|void|bool|string|bytes|guid|decimal|datetime|dateonly|timeonly|duration|uri|bigint)\\b"
        }
      ]
    },
    "genericBuiltinTypes": {
      "comment": "Map and Set have no suffix spelling — there is no T{} — so unlike Maybe/Array/Partial they are always written by name and always reach this rule.",
      "patterns": [
        {
          "name": "support.type.ionpath",
          "match": "\\b(Maybe|Array|Partial|Map|Set)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ionpath",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ionpath",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "quotedStrings": {
      "patterns": [
        {
          "name": "string.quoted.single.ionpath",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ionpath",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ionpath",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.ionpath",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.ionpath",
          "match": "\\b\\d+(?:\\s*<<\\s*\\d+)?\\b"
        }
      ]
    },
    "entityNames": {
      "patterns": [
        {
          "comment": "`mixin` included so `mixin Audited` colours its name like every other declaration. An inline `msg {` has no name and correctly does not match.",
          "match": "\\b(msg|mixin|enum|flags|service|typedef|union)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.ionpath" },
            "2": { "name": "entity.name.type.ionpath" }
          }
        }
      ]
    },
    "typeParameters": {
      "patterns": [
        {
          "name": "meta.type-parameters.ionpath",
          "begin": "<",
          "end": ">",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.begin.ionpath" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.end.ionpath" }
          },
          "patterns": [
            { "include": "#builtinTypes" },
            { "include": "#genericBuiltinTypes" },
                    {
              "name": "entity.name.type.parameter.ionpath",
              "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.comma.ionpath",
              "match": ","
            }
          ]
        }
      ]
    },
    "fieldNames": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.other.readwrite.ionpath" },
            "2": { "name": "punctuation.separator.colon.ionpath" }
          }
        }
      ]
    },
    "inheritanceType": {
      "patterns": [
        {
          "match": "(?<=:\\s*)\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.ionpath" }
          }
        }
      ]
    },
    "functionNames": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.ionpath" }
          }
        }
      ]
    },
    "enumMembers": {
      "patterns": [
        {
          "match": "^\\s*([A-Z][a-zA-Z0-9_]*)\\s*(?==|,|\\})",
          "captures": {
            "1": { "name": "constant.other.enum.ionpath" }
          }
        }
      ]
    },
    "unionCases": {
      "patterns": [
        {
          "match": "^\\s*([A-Z][a-zA-Z0-9_]*)\\s*(?=\\(|:)",
          "captures": {
            "1": { "name": "entity.name.tag.unioncase.ionpath" }
          }
        }
      ]
    },
    "typeReference": {
      "patterns": [
        {
          "name": "entity.name.type.reference.ionpath",
          "match": "(?<=:\\s*(?:stream\\s+)?)\\b([A-Z][A-Za-z0-9_]*)\\b(?!\\s*[:(])"
        }
      ]
    }
  }
}
