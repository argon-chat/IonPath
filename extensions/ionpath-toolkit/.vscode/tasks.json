{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-ionc",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/../../src/ionc/ionc.csproj",
				"--configuration", "Debug"
			],
			"group": "build",
			"problemMatcher": "$msCompile",
			"presentation": {
				"reveal": "silent",
				"showReuseMessage": false
			}
		},
		{
			"label": "build-extension",
			"type": "npm",
			"script": "compile",
			"group": "build",
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"showReuseMessage": false
			}
		},
		{
			"label": "watch-extension",
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"group": "build",
			"problemMatcher": [],
			"presentation": {
				"reveal": "silent",
				"showReuseMessage": false
			}
		},
		{
			"label": "build-all",
			"dependsOn": [
				"build-ionc",
				"build-extension"
			],
			"dependsOrder": "parallel",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		}
	]
}
