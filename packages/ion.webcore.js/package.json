{
  "name": "@argon-chat/ion.webcore",
  "version": "1.2.0",
  "description": "Browser and Node runtime for the IonPath protocol: CBOR formatters, unary and WebSocket clients, and service executors for code generated from .ion contracts.",
  "license": "MIT",
  "author": "Argon Inc. LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/argon-chat/IonPath.git",
    "directory": "packages/ion.webcore.js"
  },
  "homepage": "https://github.com/argon-chat/IonPath",
  "bugs": {
    "url": "https://github.com/argon-chat/IonPath/issues"
  },
  "keywords": ["ion", "ionpath", "cbor", "rpc", "codegen", "protocol"],
  "main": "./dist/ion.webcore.cjs",
  "module": "./dist/ion.webcore.js",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "camelcase": "^9.0.0",
    "cbor-x": "^1.6.5",
    "changelogen": "^0.6.2",
    "typescript": "6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "5.0.3",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": {
      "types": "./dist/ion.webcore.d.ts",
      "import": "./dist/ion.webcore.js",
      "require": "./dist/ion.webcore.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "release": "bun run test && bun run build && changelogen --release --no-tag",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "type": "module",
  "types": "./dist/ion.webcore.d.ts"
}
