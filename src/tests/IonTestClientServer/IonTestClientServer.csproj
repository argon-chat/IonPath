<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<PreserveCompilationContext>true</PreserveCompilationContext>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="10.0.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
		<PackageReference Include="NUnit" Version="4.5.1" />
		<PackageReference Include="NUnit.Analyzers" Version="4.12.0">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
		<!-- Dragonfly for the cross-node backplane tests (Streaming/Backplane). -->
		<PackageReference Include="Testcontainers" Version="4.13.0" />
		<!-- Testcontainers 4.13 pulls SSH.NET 2025.1.0, which has known vulnerabilities (NU1903). -->
		<PackageReference Include="SSH.NET" Version="2026.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TestServer\TestServer.csproj" />
		<ProjectReference Include="..\..\ion.runtime.network.redis\ion.runtime.network.redis.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="NUnit.Framework" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.203" />
	</ItemGroup>

	<!-- The compat probe schemas, Compat/Compat.ion, are compiled at build time (see Compat/README.md). -->
	<PropertyGroup>
		<IonProjectDirectory>Compat</IonProjectDirectory>
		<IonLockMode>none</IonLockMode>
	</PropertyGroup>
	<Import Project="..\..\ionc\InRepo.targets" />

</Project>