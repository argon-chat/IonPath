<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  The stream hub without ASP.NET Core: connections, groups, push, the backplane contract.
	  A service that only pushes to clients connected elsewhere — through the backplane — needs this
	  and a backplane, not a web server.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Ion stream hub: connections, groups, push and the backplane contract, without ASP.NET Core</Title>
		<PackageId>ionpath.runtime.streams</PackageId>
		<PackageIcon>icon-128.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.7" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\ion.runtime\ion.runtime.csproj" />
	</ItemGroup>
	<ItemGroup>
		<!-- The server's connections implement the hub's internal membership contract. -->
		<InternalsVisibleTo Include="ion.runtime.network" />
	</ItemGroup>
	<ItemGroup>
		<None Update="icon-128.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Update="GitVersion.MsBuild" Version="6.7.0" />
	  <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.203" />
	</ItemGroup>
</Project>
